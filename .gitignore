# OS and editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Logs and local runtime output
*.log
logs/
tmp/
temp/

# Dependencies and build output
node_modules/
backend/target/
dist/
build/
.next/
.turbo/
coverage/
test-results/
playwright-report/
