# Python local state
__pycache__/
*.py[cod]
.venv/
venv/

# Real or generated document content must not be committed
samples/input/*
samples/output/*
!samples/input/.gitkeep
!samples/input/e2e/
!samples/input/e2e/.gitkeep
!samples/input/e2e/README.md
!samples/output/.gitkeep

# Local agent/editor settings
.claude/settings.local.json

# Local environment and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
