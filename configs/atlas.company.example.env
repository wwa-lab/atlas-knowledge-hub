# Company environment template.
# Copy to .env inside a company-approved workspace and fill values from approved secrets/config stores.
# Do not commit the filled .env file, real endpoints, raw credentials, private paths, logs, or document content.

ATLAS_MODE=configured
ATLAS_STORAGE_MODE=local
ATLAS_DATABASE_MODE=postgres
ATLAS_VECTOR_MODE=pgvector
ATLAS_MODEL_MODE=configured

ATLAS_SAMPLE_INPUT=samples/input/e2e
ATLAS_SAMPLE_OUTPUT=samples/output/e2e
ATLAS_MARKDOWN_OUTPUT=samples/output/e2e/markdown
ATLAS_API_BASE_URL=http://127.0.0.1:8080

# Use a local or approved internal PostgreSQL instance.
ATLAS_DATABASE_URL=postgresql://atlas_user:change-me@127.0.0.1:5432/atlas_knowledge_hub

# Provider values are examples of the shape only.
ATLAS_MODEL_PROVIDER=deepseek
ATLAS_MODEL_ENDPOINT=https://api.deepseek.com
ATLAS_MODEL_API_KEY=replace-with-secret-store-value
