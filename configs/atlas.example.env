# Atlas local configuration template.
# Copy this file to .env and override values for your machine.

ATLAS_MODE=mock
ATLAS_STORAGE_MODE=local
ATLAS_DATABASE_MODE=mock
ATLAS_VECTOR_MODE=mock
ATLAS_MODEL_MODE=mock

# Local-only output roots. Keep these relative and do not commit generated content.
ATLAS_SAMPLE_INPUT=samples/input/e2e
ATLAS_SAMPLE_OUTPUT=samples/output/e2e
ATLAS_MARKDOWN_OUTPUT=samples/output/e2e/markdown
ATLAS_PLAYWRIGHT_REPORT=frontend/playwright-report

# Configured mode placeholders. Leave blank in mock mode.
ATLAS_API_BASE_URL=
ATLAS_DATABASE_URL=
ATLAS_MODEL_PROVIDER=
ATLAS_MODEL_ENDPOINT=
ATLAS_MODEL_API_KEY=
