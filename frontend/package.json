{
  "name": "atlas-knowledge-hub-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tsconfig/node24": "^24.0.2",
    "@types/node": "^25.0.0",
    "@vue/tsconfig": "^0.9.1",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^28.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.2",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.6"
  }
}
